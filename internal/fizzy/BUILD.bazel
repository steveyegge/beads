load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "fizzy",
    srcs = [
        "client.go",
        "description.go",
        "errors.go",
        "mapping.go",
        "types.go",
    ],
    importpath = "github.com/steveyegge/beads/internal/fizzy",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/types",
        "@org_golang_x_net//html",
    ],
)

go_test(
    name = "fizzy_test",
    srcs = [
        "client_test.go",
        "description_test.go",
        "fake_server_test.go",
        "mapping_test.go",
    ],
    embed = [":fizzy"],
    deps = ["//internal/types"],
)

# --- begin repo_files (managed by tools/bazel/go_srcs.py; run `make bazel-sync`) ---

filegroup(
    name = "repo_doc_files",
    srcs = glob(
        [
            "**/*.md",
            "**/*.mdx",
        ],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_srcs",
    srcs = glob(
        ["**/*.go"],
        allow_empty = True,
        exclude = [
            "**/*_test.go",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_go_test_srcs",
    srcs = glob(
        ["**/*_test.go"],
        allow_empty = True,
        exclude = ["**/node_modules/**"],
    ),
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "repo_other_files",
    srcs = glob(
        ["**"],
        exclude = [
            "**/*.db",
            "**/*.exe",
            "**/*.go",
            "**/*.md",
            "**/*.mdx",
            "**/*.out",
            "**/*.prof",
            "**/*.pyc",
            "**/*.test",
            "**/__pycache__/**",
            "**/node_modules/**",
        ],
    ),
    visibility = ["//:__subpackages__"],
)

# --- end repo_files ---
